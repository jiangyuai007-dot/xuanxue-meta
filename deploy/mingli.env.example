# mingli 生产环境变量模板
# 用法：cp 到 /etc/mingli/mingli.env，chmod 600，按需填项
# 全部可选——不填任何 AI 配置时走本地规则引擎，功能完整可跑

# —— 网络绑定（反代后面只绑回环，公网 8787 不直接暴露）——
PORT=8787
HOST=127.0.0.1

# 日志/缓存时间基准：面向中文用户按北京时间
TZ=Asia/Shanghai

# —— AI 解读：二选一，不要同时配；都不配 = 纯本地规则引擎 ——
# A. AGNES 适配器（默认启用，AI_ENABLED=1）
AI_ENABLED=1
# AGNES_API_KEY=sk-xxxxxxxxxxxxxxxx
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.5-flash
# AGNES_TIMEOUT_MS=40000
# AI_CONCURRENCY=2

# B. 任意 OpenAI 兼容端点（配了 LLM_ENDPOINT 就走这套）
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# —— 商业化 ——
# 权益令牌签名密钥：必须设置！openssl rand -hex 32 生成。
# 不设则落在 data/.secret，重装/换机会导致旧分享链接全部失效。
XUANXUE_SECRET=
# 付费总开关：不设 = 免费模式（全部章节可直接读，下单链路保留）
# XUANXUE_PAID=1

# —— 演示联调（生产环境勿开）——
# XUANXUE_DEMO_UNLOCK=1
